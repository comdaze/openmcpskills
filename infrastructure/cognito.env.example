# Cognito Authentication Configuration
# Copy to cognito.env and fill in your values.
# Generated by: ./infrastructure/setup_cognito.sh

# User Pool
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_REGION=us-east-1
DOMAIN_PREFIX=your-domain-prefix

# S2S (Service-to-Service) Authentication
COGNITO_ENABLED=true
COGNITO_TOKEN_ENDPOINT=https://your-domain-prefix.auth.us-east-1.amazoncognito.com/oauth2/token
COGNITO_ALLOWED_CLIENT_IDS=
COGNITO_RESOURCE_SERVER=openmcpskills-api
COGNITO_SCOPES=openmcpskills-api/mcp,openmcpskills-api/read

# S2S Test Credentials — create via frontend dashboard (Settings > Cognito Credentials)
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=

# Frontend App Client (public, no secret)
COGNITO_FRONTEND_CLIENT_ID=
