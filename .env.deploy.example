# Deployment Configuration Example
# Copy this file to .env.deploy and edit the values

# AWS Configuration
REGION=us-east-1
CLUSTER=open-mcp-skills

# API Configuration
API_BASE_URL=https://your-domain.example.com

# Backend Service
BACKEND_SERVICE=mcp-server-alb
BACKEND_TASK_FAMILY=open-mcp-skills

# Frontend Service
FRONTEND_SERVICE=skillforge-frontend
FRONTEND_TASK_FAMILY=skillforge-frontend

# ECS Task Configuration
ECS_EXECUTION_ROLE=ecsTaskExecutionRole
FRONTEND_CPU=256
FRONTEND_MEMORY=512

# S3 Configuration
S3_SKILLS_BUCKET_NAME=mcp-skills-bucket
S3_SKILLS_PREFIX=skills/
S3_OUTPUT_PREFIX=output_artifacts/

# DynamoDB Tables
DYNAMODB_SKILLS_TABLE=mcp-skills
DYNAMODB_SESSIONS_TABLE=mcp-sessions
DYNAMODB_INVOCATION_LOGS_TABLE=mcp-invocation-logs

# Backend Environment Variables (Production)
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
STORAGE_BACKEND=s3
SKILLS_DIR=/app/skills
SKILL_CACHE_DIR=/tmp/skill-cache
SKILLS_WATCH_ENABLED=false
INVOCATION_LOG_TTL_DAYS=30
CODE_INTERPRETER_ENABLED=true
CODE_INTERPRETER_ID=
CODE_INTERPRETER_DEFAULT_TIMEOUT=300
CODE_INTERPRETER_SESSION_TIMEOUT=900

# --- Authentication ---
# API Key auth: enable to require X-API-Key header for MCP requests.
# Keys are managed via the admin dashboard (DynamoDB-backed, persistent).
# MCP_API_KEYS is optional — only needed for static/bootstrap keys.
# Leave it empty to manage all keys through the dashboard.
MCP_AUTH_ENABLED=false
MCP_API_KEYS=

# Cognito S2S (Service-to-Service) Authentication
# Enable to require OAuth 2.0 Bearer tokens (Client Credentials flow).
# Clients are provisioned via the admin dashboard.
# COGNITO_ALLOWED_CLIENT_IDS: comma-separated whitelist. Leave empty to
# accept any client from the User Pool (recommended for self-service).
COGNITO_ENABLED=false
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1
COGNITO_ALLOWED_CLIENT_IDS=
COGNITO_TOKEN_ENDPOINT=
COGNITO_CLIENT_ID=
COGNITO_SCOPES=openmcpskills-api/mcp,openmcpskills-api/read
